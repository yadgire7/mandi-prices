# Copy to .env, then: chmod 600 .env
# Never commit .env. Never paste these values anywhere else.

# data.gov.in API key
DATA_GOV_IN_API_KEY=

# The mailbox that sends the run emails (use an app password, not your login password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
